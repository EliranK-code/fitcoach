# ===== Anthropic (required to talk to the bot) =====
ANTHROPIC_API_KEY=
# The main model. You can switch to claude-sonnet-5-5 to save cost
CLAUDE_MODEL=claude-opus-5-5
# Model for conversation summaries (empty = the same as CLAUDE_MODEL)
CLAUDE_SUMMARY_MODEL=
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
# default = automatic switch to a fallback model when a safety classifier declines a request. off = disabled
CLAUDE_FALLBACKS=default

# ===== OpenAI (optional: vector search and voice message transcription) =====
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# ===== Database =====
# Empty = local PGlite in the PGLITE_DIR folder. In production: a Postgres connection string (for example Supabase).
# Any host other than localhost is encrypted (TLS) automatically. ?sslmode=verify-full also verifies the certificate
DATABASE_URL=
PGLITE_DIR=.data/pglite

# ===== Encryption (required) =====
# 32 bytes in base64. Created automatically by npm run setup. Never lose it: without it the data can't be decrypted
MASTER_ENCRYPTION_KEY=

# ===== Behavior =====
EPOCH_MAX_TOKENS=24000
EPOCH_IDLE_HOURS=72
KNOWLEDGE_INLINE_MAX_TOKENS=30000
RETENTION_MONTHS=24
TIMEZONE=Asia/Jerusalem
LOG_LEVEL=warn

# ===== WhatsApp Cloud API =====
# A System User token from Meta Business (for numbers managed under your account)
WHATSAPP_ACCESS_TOKEN=
# App Secret from the app settings in Meta (verifies the webhook signature)
WHATSAPP_APP_SECRET=
# A secret string you make up and also enter in Meta when you set up the webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Embedded Signup: coaches connect a number themselves. The app id in Meta, and the Login for Business configuration id.
# Without both the button isn't available (with WHATSAPP_DRY_RUN=true it works in simulation mode)
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# true = don't really send to Meta, just print to the log (for local testing)
WHATSAPP_DRY_RUN=false
PORT=3000
# How long to wait after a client's last message before answering (merges consecutive messages)
INBOUND_DEBOUNCE_MS=4000
WORKER_CONCURRENCY=4

# --- Usage and limits ---
# What Meta charges per template message, for cost estimates (depends on country and category). 0 = unknown
WHATSAPP_TEMPLATE_PRICE_USD=0
# Messages per hour the bot answers for one client. Beyond that, messages are kept for the coach and an alert opens. 0 = no limit
CLIENT_HOURLY_MESSAGE_LIMIT=30
# The same per day. 0 = no limit
CLIENT_DAILY_MESSAGE_LIMIT=150
# Hard monthly cap per coach in USD: when it's reached the bot stops answering. An admin can set another per coach. 0 = no cap
COACH_MONTHLY_CAP_USD=200
# Hard daily cap for the whole platform in USD (UTC): when it's reached every bot stops answering until tomorrow. 0 = no cap
PLATFORM_DAILY_CAP_USD=100

# ===== Deployment =====
# The header your hosting provider's proxy sets to the user's IP (for example x-real-ip), for login throttling.
# Empty = the last X-Forwarded-For value. Never the first: the user writes that one
TRUSTED_IP_HEADER=
# false = the dashboard doesn't run the worker and scheduler itself (when they run as a separate service)
DASHBOARD_RUN_WORKER=true
