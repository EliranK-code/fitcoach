# ===== Anthropic (חובה כדי לדבר עם הבוט) =====
ANTHROPIC_API_KEY=
# המודל הראשי. אפשר להחליף ל-claude-sonnet-5-5 כדי להוזיל
CLAUDE_MODEL=claude-opus-5-5
# מודל לסיכומי שיחה (ריק = אותו מודל כמו CLAUDE_MODEL)
CLAUDE_SUMMARY_MODEL=
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
# default = מעבר אוטומטי למודל חלופי כשמסווג בטיחות דוחה בקשה. off = כבוי
CLAUDE_FALLBACKS=default

# ===== OpenAI (רשות: חיפוש וקטורי ותמלול הודעות קוליות) =====
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# ===== מסד נתונים =====
# ריק = PGlite מקומי בתיקייה PGLITE_DIR. משלב 2: connection string של Supabase.
# לכל שרת שאינו localhost החיבור מוצפן (TLS) אוטומטית. ?sslmode=verify-full בודק גם את התעודה
DATABASE_URL=
PGLITE_DIR=.data/pglite

# ===== הצפנה (חובה) =====
# 32 בייטים ב-base64. נוצר אוטומטית ע"י npm run setup. אסור לאבד אותו: בלעדיו המידע לא ניתן לפענוח
MASTER_ENCRYPTION_KEY=

# ===== התנהגות =====
EPOCH_MAX_TOKENS=24000
EPOCH_IDLE_HOURS=72
KNOWLEDGE_INLINE_MAX_TOKENS=30000
RETENTION_MONTHS=24
TIMEZONE=Asia/Jerusalem
LOG_LEVEL=warn

# ===== WhatsApp Cloud API (שלב 2) =====
# טוקן של System User מ-Meta Business (למספרים שמנוהלים תחת החשבון שלך)
WHATSAPP_ACCESS_TOKEN=
# App Secret מהגדרות האפליקציה ב-Meta (לאימות חתימת ה-webhook)
WHATSAPP_APP_SECRET=
# מחרוזת סודית שתמציאו ותזינו גם ב-Meta בהגדרת ה-webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Embedded Signup: מאמנים מחברים מספר בעצמם. מזהה האפליקציה ב-Meta, ומזהה ההגדרה של Login for Business.
# בלי שניהם הכפתור לא זמין (ב-WHATSAPP_DRY_RUN=true הוא עובד במצב סימולציה)
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# true = לא שולחים באמת ל-Meta, רק מדפיסים ללוג (לבדיקות מקומיות)
WHATSAPP_DRY_RUN=false
PORT=3000
# כמה זמן לחכות אחרי הודעה אחרונה של לקוח לפני שעונים (מאחד הודעות רצופות)
INBOUND_DEBOUNCE_MS=4000
WORKER_CONCURRENCY=4

# --- שימוש ומגבלות (שלב 5) ---
# המחיר ש-Meta גובה על הודעת תבנית, להערכת עלויות (תלוי במדינה ובקטגוריה). 0 = לא ידוע
WHATSAPP_TEMPLATE_PRICE_USD=0
# כמה הודעות בשעה הבוט עונה ללקוח אחד. מעבר לזה ההודעות נשמרות למאמן ונפתחת התראה. 0 = בלי הגבלה
CLIENT_HOURLY_MESSAGE_LIMIT=30
# אותו דבר ליממה. 0 = בלי הגבלה
CLIENT_DAILY_MESSAGE_LIMIT=150
# תקרה קשיחה חודשית למאמן בדולרים: כשמגיעים אליה הבוט מפסיק לענות. אדמין יכול לקבוע אחרת לכל מאמן. 0 = בלי תקרה
COACH_MONTHLY_CAP_USD=200
# תקרה קשיחה יומית לכל הפלטפורמה בדולרים (לפי UTC): כשמגיעים אליה כל הבוטים מפסיקים לענות עד מחר. 0 = בלי תקרה
PLATFORM_DAILY_CAP_USD=100

# ===== פריסה =====
# הכותרת שהפרוקסי של ספק האחסון מוסיף עם ה-IP של המשתמש (למשל x-real-ip), להגבלת ניסיונות התחברות.
# ריק = הערך האחרון ב-X-Forwarded-For. אף פעם לא הראשון: אותו המשתמש כותב בעצמו
TRUSTED_IP_HEADER=
# false = הדשבורד לא מריץ בעצמו את ה-worker והמתזמן (כשהם רצים בשירות נפרד)
DASHBOARD_RUN_WORKER=true
